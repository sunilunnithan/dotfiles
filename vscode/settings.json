{
  // font settings
  "chat.fontFamily": "Monaspace Neon NF",
  "fonted.font": "Monaspace Neon NF",
  "breadcrumbs.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.stickyScroll.enabled": true,
  "editor.suggest.insertMode": "replace",
  "editor.fontSize": 16,
  "terminal.integrated.fontSize": 16,
  "editor.matchBrackets": "always",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.glyphMargin": false,
  "editor.wordBasedSuggestions": "off",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.roundedSelection": false,
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "none",
  "editor.cursorStyle": "block",
  "editor.cursorBlinking": "solid",
  "editor.folding": false,
  "editor.insertSpaces": false,
  "editor.formatOnSave": true,
  "editor.fontFamily": "Monaspace Neon NF",
  "editor.fontLigatures": true,
  "editor.fontWeight": "450",
  "editor.lineNumbers": "relative",
  "zenMode.hideLineNumbers": false,
  "terminal.integrated.fontFamily": "Monaspace Neon NF",
  "terminal.integrated.fontLigatures": true,
  "editor.suggestSelection": "first",
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.git": true,
    "**/.factorypath": true
  },
  "python.languageServer": "Pylance",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "workbench.colorTheme": "Raven",
  "workbench.iconTheme": "rose-pine-symbols",
  "workbench.sideBar.location": "right",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "go.buildFlags": [
    "-v"
  ],
  "go.useLanguageServer": true,
  "go.autocompleteUnimportedPackages": true,
  "go.testEnvFile": "",
  "go.toolsManagement.autoUpdate": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.cursorSurroundingLines": 10,
  "workbench.enableExperiments": false,
  // "workbench.sidebar.visible": false,
  // oil settings
  "oil-code.disableOpenCwdNothingOpen": true,
  "oil-code.hasNerdFont": true,
  "oil-code.disableVimKeymaps": true,
  // telescope settings
  "codeTelescope.wsFileFinder.excludeHidden": false, // include . files in file finder
  "codeTelescope.layout.mode": "classic",
  "codeTelescope.layout.panelContainerPct": 95,
  "codeTelescope.layout.promptFontSize": 12,
  "codeTelescope.layout.resultsFontSize": 12,
  "codeTelescope.layout.previewFontSize": 12,
  // error lens settings
  "errorLens.fontStyleItalic": true,
  // formatting
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
    "source.fixAll.eslint": "always"
  },
  // misc
  "editor.linkedEditing": true, // auto rename tag
  "extensions.allowOpenInModalEditor": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": false,
  "workbench.editor.enablePreview": false,
  //vim settings
  "vim.leader": "<Space>",
  "vim.easymotion": true,
  "vim.enableNeovim": false,
  "vim.cursorStylePerMode.insert": "underline",
  "vim.sneak": true,
  "vim.smartRelativeLine": true,
  "vim.visualstar": true,
  "vim.neovimUseConfigFile": true,
  "vim.incsearch": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "rgba(250, 240, 170, 0.5)",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.useCtrlKeys": true,
  "vim.changeWordIncludesWhitespace": true,
  "vim.surround": true,
  "vim.history": 1000,
  "vim.smartcase": true,
  "vim.searchHighlightColor": "rgba(150, 255, 255, 0.3)",
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<ESC>"
      ]
    },
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<ESC>"
      ]
    },
    {
      "before": [
        "k",
        "j"
      ],
      "after": [
        "<ESC>"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "commands": [
        "cursorRight"
      ]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [
        ">"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "<"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "U"
      ],
      "after": [
        "<C-r>"
      ]
    },
    {
      "before": [
        "J"
      ],
      "after": [
        "<C-d>",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "K"
      ],
      "after": [
        "<C-u>",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "H"
      ],
      "commands": [
        "workbench.action.previousEditor"
      ]
    },
    {
      "before": [
        "L"
      ],
      "commands": [
        "workbench.action.nextEditor"
      ]
    },
    {
      "before": [
        "n"
      ],
      "after": [
        "n",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "N"
      ],
      "after": [
        "N",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        "workbench.action.focusLeftGroup"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "commands": [
        "workbench.action.focusRightGroup"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "whichkey.show"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "whichkey.show"
      ]
    },
    {
      "before": [
        ">"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "<"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    }
  ],
  "whichkey.useFullWidthCharacters": true,
  "whichkey.bindingOverrides": [],
  "whichkey.bindings": [
    {
      "key": "e",
      "name": "Open File [T]ree",
      "type": "command",
      "command": "workbench.view.explorer"
    },
    {
      "key": "o",
      "name": "Open Oil",
      "type": "command",
      "command": "oil-code.open"
    },
    {
      "key": "h",
      "name": "+harpoon",
      "type": "bindings",
      "bindings": [
        {
          "key": "a",
          "name": "[A]dd File",
          "type": "command",
          "command": "code-telescope.harpoon.addFile"
        },
        {
          "key": "r",
          "name": "[R]emove Current File",
          "type": "command",
          "command": "code-telescope.harpoon.removeCurrentFile"
        },
        {
          "key": "c",
          "name": "[C]lear All Marks",
          "type": "command",
          "command": "code-telescope.harpoon.clear"
        },
        {
          "key": "1",
          "name": "Go to File 1",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile1"
        },
        {
          "key": "2",
          "name": "Go to File 2",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile2"
        },
        {
          "key": "3",
          "name": "Go to File 3",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile3"
        },
        {
          "key": "4",
          "name": "Go to File 4",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile4"
        },
        {
          "key": "5",
          "name": "Go to File 5",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile5"
        },
        {
          "key": "6",
          "name": "Go to File 6",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile6"
        },
        {
          "key": "7",
          "name": "Go to File 7",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile7"
        },
        {
          "key": "8",
          "name": "Go to File 8",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile8"
        },
        {
          "key": "9",
          "name": "Go to File 9",
          "type": "command",
          "command": "code-telescope.harpoon.gotoFile9"
        }
      ]
    },
    {
      "key": "p",
      "name": "Yank History",
      "args": ":registers",
      "command": "vim.commandMode"
    },
    {
      "key": ",",
      "name": "[,] Quick Open",
      "type": "command",
      "command": "workbench.action.quickOpen"
    },
    {
      "key": "/",
      "name": "[/] Fuzzy search in current editor",
      "type": "command",
      "command": "fuzzySearch.activeTextEditor"
    },
    {
      "key": "-",
      "name": "Split window below",
      "type": "command",
      "command": "workbench.action.splitEditorDown"
    },
    {
      "key": "|",
      "name": "Split window right",
      "type": "command",
      "command": "workbench.action.splitEditorRight"
    },
    {
      "key": "`",
      "name": "Switch to other editor",
      "type": "command",
      "command": "workbench.action.openPreviousRecentlyUsedEditor"
    },
    {
      "key": "q",
      "name": "Close Active Editor",
      "type": "command",
      "command": "workbench.action.closeActiveEditor"
    },
    {
      "key": "a",
      "name": "+ai",
      "type": "bindings",
      "bindings": [
        {
          "key": "a",
          "name": "Toggle Copilot AI",
          "type": "command",
          "command": "workbench.panel.chat"
        }
      ]
    },
    {
      "key": "b",
      "name": "+buffer",
      "type": "bindings",
      "bindings": [
        {
          "key": "d",
          "name": "Delete Buffer",
          "type": "command",
          "command": "workbench.action.closeActiveEditor"
        },
        {
          "key": "l",
          "name": "Close [L]eft Buffer",
          "type": "command",
          "command": "workbench.action.closeEditorsToTheLeft"
        },
        {
          "key": "r",
          "name": "Close [R]ight Buffer",
          "type": "command",
          "command": "workbench.action.closeEditorsToTheRight"
        },
        {
          "key": "o",
          "name": "Delete [O]ther Buffers",
          "type": "command",
          "command": "workbench.action.closeOtherEditors"
        }
      ]
    },
    {
      "key": "c",
      "name": "+code",
      "type": "bindings",
      "bindings": [
        {
          "key": "a",
          "name": "Code Action",
          "type": "command",
          "command": "editor.action.codeAction"
        },
        {
          "key": "d",
          "name": "[R]un with [D]ebuging",
          "type": "command",
          "command": "workbench.action.debug.start"
        },
        {
          "key": "D",
          "name": "[R]un Without debugging",
          "type": "command",
          "command": "workbench.action.debug.run"
        },
        {
          "key": "c",
          "name": "[R]efactor [C]ode",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "f",
          "name": "Format file",
          "type": "command",
          "command": "editor.action.formatDocument"
        },
        {
          "key": "n",
          "name": "[R]e[N]ame Symbol",
          "type": "command",
          "command": "editor.action.rename"
        },
        {
          "key": "p",
          "name": "Copy file path",
          "type": "command",
          "command": "copyFilePath"
        },
        {
          "key": "r",
          "name": "Rename file",
          "type": "command",
          "command": "workbench.action.files.renameFile"
        },
        {
          "key": "h",
          "name": "Call [H]ierarchy (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.callHierarchy"
        },
        {
          "key": "R",
          "name": "Workspace [R]eferences (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.lspRefs"
        },
        {
          "key": "B",
          "name": "Workspace [B]reakpoints (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.breakpoints"
        }
      ]
    },
    {
      "key": "f",
      "name": "+file",
      "type": "bindings",
      "bindings": [
        {
          "key": "b",
          "name": "Find Buffer (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.recentFiles"
        },
        {
          "key": "f",
          "name": "Find Files (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.file"
        },
        {
          "key": "n",
          "name": "Create new file",
          "type": "command",
          "command": "workbench.action.files.newUntitledFile"
        },
        {
          "key": "r",
          "name": "Recent Files",
          "type": "command",
          "command": "workbench.action.openRecent"
        },
        {
          "key": "s",
          "name": "Open [S]ettings (JSON)",
          "type": "command",
          "command": "workbench.action.openSettingsJson"
        },
        {
          "key": "k",
          "name": "Open [K]eybindings (JSON)",
          "type": "command",
          "command": "workbench.action.openGlobalKeybindingsFile"
        }
      ]
    },
    {
      "key": "g",
      "name": "+git",
      "type": "bindings",
      "bindings": [
        {
          "key": "b",
          "name": "Open file in GitHub",
          "type": "command",
          "command": "github.OpenOnGitHub"
        },
        {
          "key": "B",
          "name": "[G]it [B]ranches (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.branch"
        },
        {
          "key": "v",
          "name": "[G]it Diffs (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.diff"
        },
        {
          "key": "c",
          "name": "[G]it [C]ommits (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.commit"
        },
        {
          "key": "s",
          "name": "[G]it [S]tashes (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.stash"
        },
        {
          "key": "e",
          "name": "Open Git Explorer",
          "type": "command",
          "command": "workbench.view.scm"
        },
        {
          "key": "d",
          "name": "[G]oto [D]efinition",
          "type": "command",
          "command": "editor.revealDefinition"
        },
        {
          "key": "l",
          "name": "View Git Log",
          "type": "command",
          "command": "workbench.scm.action.graph.viewChanges"
        },
        {
          "key": "r",
          "name": "[G]oto [R]eferences",
          "type": "command",
          "command": "editor.action.goToReferences"
        },
        {
          "key": "I",
          "name": "[G]oto [I]mplementation",
          "type": "command",
          "command": "editor.action.goToImplementation"
        },
        {
          "key": "D",
          "name": "[G]oto [D]eclaration",
          "type": "command",
          "command": "editor.action.revealDeclaration"
        }
      ]
    },
    {
      "key": "s",
      "name": "+search",
      "type": "bindings",
      "bindings": [
        {
          "key": "p",
          "name": "[S]earch Command [P]alette",
          "type": "command",
          "command": "workbench.action.showCommands"
        },
        {
          "key": "g",
          "name": "[S]earch [G]rep (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.wsText"
        },
        {
          "key": "k",
          "name": "[S]earch [K]eybindings (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.keybindings"
        },
        {
          "key": "d",
          "name": "[S]earch [D]iagnostics (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.diagnostics"
        },
        {
          "key": "R",
          "name": "[S]earch [R]esume Last (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.resume"
        },
        {
          "key": "s",
          "name": "[S]earch [S]ymbols (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.documentSymbols"
        },
        {
          "key": "S",
          "name": "[S]earch [S]ymbols Workspace (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.wsSymbols"
        },
        {
          "key": "f",
          "name": "[S]earch Current [F]ile Text (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.fileText"
        },
        {
          "key": ".",
          "name": "[S]earch Recent Files",
          "type": "command",
          "command": "workbench.action.openRecent"
        }
      ]
    },
    {
      "key": "u",
      "name": "+ui",
      "type": "bindings",
      "bindings": [
        {
          "key": "z",
          "name": "Enable Zen Mode",
          "type": "command",
          "command": "workbench.action.toggleZenMode"
        },
        {
          "key": "c",
          "name": "[C]olor Scheme (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.colorschemes"
        },
        {
          "key": "f",
          "name": "[F]ont Family (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.fontFamily"
        },
        {
          "key": "e",
          "name": "[E]xtensions (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.extensions"
        },
        {
          "key": "p",
          "name": "[P]ackage Docs (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.pkgDocs"
        },
        {
          "key": "t",
          "name": "[T]asks (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.tasks"
        },
        {
          "key": "a",
          "name": "[A]ll Telescope Finders",
          "type": "command",
          "command": "code-telescope.fuzzy.builtin"
        },
        {
          "key": "s",
          "name": "[S]elect Search Tool (Telescope)",
          "type": "command",
          "command": "code-telescope.fuzzy.custom"
        }
      ]
    },
    {
      "key": "w",
      "name": "+window",
      "type": "bindings",
      "bindings": [
        {
          "key": "h",
          "name": "Go to left editor",
          "type": "command",
          "command": "workbench.action.navigateLeft"
        },
        {
          "key": "l",
          "name": "Go to right editor",
          "type": "command",
          "command": "workbench.action.navigateRight"
        },
        {
          "key": "k",
          "name": "Go to top editor",
          "type": "command",
          "command": "workbench.action.navigateUp"
        },
        {
          "key": "j",
          "name": "Go to down editor",
          "type": "command",
          "command": "workbench.action.navigateDown"
        },
        {
          "key": "s",
          "name": "Split window",
          "type": "command",
          "command": "workbench.action.splitEditorDown"
        },
        {
          "key": "v",
          "name": "Vertical Split window",
          "type": "command",
          "command": "workbench.action.splitEditor"
        },
        {
          "key": "o",
          "name": "Close other editors",
          "type": "command",
          "command": "workbench.action.closeOtherEditors"
        }
      ]
    }
  ],
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  // window chrome
  "workbench.activityBar.compact": true,
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "window.titleBarStyle": "custom",
  "window.title": "${activeEditorShort}",
  "workbench.activityBar.location": "top",
  "window.commandCenter": false,
  "workbench.panel.opensMaximized": "always",
  "workbench.panel.showLabels": false,
  "workbench.editor.showTabs": "none",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "vsicons.dontShowNewVersionMessage": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "git.autofetch": true
}